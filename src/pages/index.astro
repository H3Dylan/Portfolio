  <section id="formation">
    <div class="wrap">
      <div class="section-head">
        <h2>Formations</h2>
        <span class="count mono">2020 – 2026</span>
      </div>
      <div class="timeline">
        <article class="job">
          <div class="job-top">
            <span class="job-date mono">2024 – 2026</span>
