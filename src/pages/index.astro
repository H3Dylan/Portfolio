            <span class="tile"><img src="/icons/proxmox.svg" alt="" /><em>Proxmox</em></span>
            <span class="tile"><img src="/icons/traefik.svg" alt="" /><em>Traefik</em></span>
            <span class="tile"><img src="/icons/nginx.svg" alt="" /><em>Nginx</em></span>
            <span class="tile mono-logo" style="--logo: url('/icons/wireguard.svg')"><i></i><em>WireGuard</em></span>
            <span class="tile no-logo"><em>BIND (DNS)</em></span>
          </div>
        </div>
        <div class="skill-card">
          <h3>CMS</h3>
          <div class="tiles">
            <span class="tile"><img src="/icons/wordpress.svg" alt="" /><em>WordPress</em></span>
            <span class="tile mono-logo" style="--logo: url('/icons/elementor.svg')"
              ><i></i><em>Elementor</em></span
